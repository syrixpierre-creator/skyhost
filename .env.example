# SKYHOST configuration. scripts/install.sh copies this file to .env and fills every secret marked
# "generated" with a random value. It never overwrites an existing .env.
# Never commit .env: it contains your encryption keys and payment secrets.

# ----------------------------------------------------------------------------------------- domains
# Dashboard URL. The API is served on the same origin under /api.
SKYHOST_DASHBOARD_URL=https://skyhost.tech
SKYHOST_API_URL=https://skyhost.tech
# Applications get <service>-<id>.<SKYHOST_BASE_DOMAIN>. Point a wildcard DNS record (*.skyhost.tech) to this server.
# It may be the dashboard's own domain: session cookies are __Host- cookies, which applications cannot overwrite.
SKYHOST_BASE_DOMAIN=skyhost.tech
SKYHOST_PUBLIC_SCHEME=https
SKYHOST_TLS=true
# Let's Encrypt account email (required for automatic HTTPS).
ACME_EMAIL=syrixcompany@gmail.com
# Support and administration contact shown to users (sign-in pages, suspended teams, contact sales).
SKYHOST_SUPPORT_EMAIL=syrixcompany@gmail.com
SKYHOST_CERT_RESOLVER=letsencrypt
# Recommended: one wildcard certificate (*.your-domain) for every app instead of one per app, which avoids the
# Let's Encrypt limit of 50 new certificates per domain per week. Needs the domain's DNS on Cloudflare:
# set SKYHOST_WILDCARD_CERT_RESOLVER=letsencrypt-dns and an API token with "Zone · DNS · Edit" on the zone.
SKYHOST_WILDCARD_CERT_RESOLVER=
CLOUDFLARE_DNS_API_TOKEN=
SKYHOST_REGION=eu-west
# Public IPs shown in custom domain DNS instructions.
SKYHOST_PUBLIC_IPV4=
SKYHOST_PUBLIC_IPV6=
# Host name users connect to for databases with public access enabled.
SKYHOST_DATABASE_PUBLIC_HOST=db.skyhost.tech

# ----------------------------------------------------------------------------------------- secrets (generated)
# Encryption keyring for secrets, variables and backups: "id:base64(32 bytes)", comma separated.
# The first key encrypts new data; keep old keys listed to decrypt existing data after a rotation.
SKYHOST_MASTER_KEYS=
SKYHOST_INTERNAL_TOKEN=
SKYHOST_SESSION_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------------------- isolation
# OCI runtime for customer containers. "runsc" (gVisor) is strongly recommended in production;
# "runc" offers weaker isolation and is meant for development only.
SKYHOST_CONTAINER_RUNTIME=runsc
SKYHOST_BUILD_RUNTIME=runsc
SKYHOST_BUILD_TIMEOUT=1800
SKYHOST_BUILD_MEMORY_MB=4096
SKYHOST_BUILD_CPUS=2
SKYHOST_BUILD_CONCURRENCY=2
# Optional buildkitd.toml for the build worker's BuildKit (registry mirrors, private CA), mounted into the worker.
SKYHOST_BUILDKITD_CONFIG=
# BuildKit image for the build worker's builder (pin a version, e.g. moby/buildkit:v0.24.0). Empty: buildx default.
SKYHOST_BUILDKIT_IMAGE=
# Private registry for multi-node setups (start the "registry" profile), e.g. 127.0.0.1:5000. Empty: images stay local.
SKYHOST_REGISTRY=

# ----------------------------------------------------------------------------------------- email
# smtp://user:pass@smtp.example.com:587 — required to deliver emails (verification, invitations, resets, alerts).
# Local testing: start the "mail" profile and use smtp://mailpit:1025 (UI on 127.0.0.1:8025).
SMTP_URL=
MAIL_FROM=SKYHOST <no-reply@skyhost.tech>
SKYHOST_REQUIRE_EMAIL_VERIFICATION=true

# ----------------------------------------------------------------------------------------- git providers
# GitHub App (recommended): repository access, webhooks, PR previews and status checks.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key with "\n" escaped newlines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# GitHub OAuth app for "Continue with GitHub".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client for "Continue with Google" (optional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITLAB_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_WEBHOOK_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------------------- payments
# Payments stay disabled until you set this to true. Use sandbox keys first.
SKYHOST_PAYMENTS_ENABLED=false
BILLING_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Sandbox by default. Production: https://api-m.paypal.com
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ----------------------------------------------------------------------------------------- object storage
# fs (default): encrypted files on the "objects" Docker volume. s3: any S3-compatible service.
STORAGE_DRIVER=fs
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Image used for customer buckets (one S3 gateway container per bucket).
SKYHOST_BUCKET_IMAGE=versity/versitygw:v1.0.16

# ----------------------------------------------------------------------------------------- images
SKYHOST_IMAGE_PREFIX=skyhost
SKYHOST_VERSION=latest
LOG_LEVEL=info
